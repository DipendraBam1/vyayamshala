{
  "compilerOptions": {
    "target": "ES2022",
    "module": "preserve",
    "moduleResolution": "bundler",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
   "typeRoots": [
  "./node_modules/@types",
  "../../node_modules/@types"
],
"types": ["node"]
  },
  "include": ["src"],
  "exclude": ["dist", "node_modules"]
}